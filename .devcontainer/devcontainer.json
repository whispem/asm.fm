{
  "name": "asm.fm",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "runArgs": ["--platform=linux/amd64"],
  "workspaceFolder": "/asmfm",
  "workspaceMount": "source=${localWorkspaceFolder},target=/asmfm,type=bind",
  "customizations": {
    "vscode": {
      "extensions": [
        "13xforever.language-x86-64-assembly"
      ]
    }
  }
}